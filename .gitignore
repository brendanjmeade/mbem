# Consolidated from the five .gitignore files the sub-project tree carried
# (root, msd/, clq/, moss/, medt_paper/). Paths are retargeted to the packaged
# layout; the dead fbem/cache/ rule is dropped.

# Python / numba build output
__pycache__/
*.py[cod]
*.nbi
*.nbc

# Packaging / test tooling
*.egg-info/
build/
dist/
.pytest_cache/

# macOS
.DS_Store

# Per-run output. The run directory is the artifact; nothing in it is tracked.
runs/

# Study outputs. Figures are regenerable, so the PDFs are ignored and only the
# curated PNG gallery under docs/figures/ is tracked -- see docs/figures/.
studies/**/fig_*.pdf
studies/**/fig_*.png
docs/figures/*.pdf

# Solver output npz written by the studies. NOTHING binary is tracked any more:
# a run's fields belong in its own runs/ directory with the provenance of the
# solve that made them, and these are all regenerable
# (python -m mbem.cases.topo_inclusion, ~2 min).
studies/mbem/*.npz

# bench_scaling's mesh cache defaults to ~/.cache/msd_bench_meshes, OUTSIDE the
# tree, because the mesher takes ~5 min at 168k and a cache is not source. This
# rule only covers --mesh-cache being pointed back in here.
studies/mbem/_cache/
